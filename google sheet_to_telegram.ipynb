   "source": [
    "import time\n",
    "import gspread\n",
    "import requests\n",
    "from oauth2client.service_account import ServiceAccountCredentials\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f4bcb345",
   "metadata": {},
   "outputs": [],
   "source": [
    "scope = [\"https://spreadsheets.google.com/feeds\", \"https://www.googleapis.com/auth/drive\"]\n",
    "creds = ServiceAccountCredentials.from_json_keyfile_name(\"YOUR_JSON_KEY_PATH_HERE\", scope)\n",
    "client = gspread.authorize(creds)\n",
    "sheet = client.open(\"AutomationSheet\").sheet1
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "b1696b84",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Telegram setup\n",
    "BOT_TOKEN = \"8224445200:AAF_tgqPivZBpA6ZTD6jJpT-EkXZNek7gRI\"  # your bot token\n",
    "CHAT_ID = \"1208656939\"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "be09cf3d",
   "metadata": {},
   "outputs": [],
   "source": [
    "#Function to send message to Telegram \n",
    "def send_telegram_message(message):\n",
    "    url=f\"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage\"\n",
    "    params={\"chat_id\": CHAT_ID, \"text\": message}\n",
    "    response=requests.get(url, params=params)\n",
    "    if response.status_code==200:\n",
    "        print(f\"Sent: {message}\")\n",
    "    else:\n",
    "        print(f\"Failed to send: {response.text}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "c3a829c4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Sent: This message confirms the automatic message sending from google sheets to telegram bot\n"
     ]
    }
   ],
   "source": [
    "#Send all messages from the sheet\n",
    "data=sheet.get_all_records()\n",
    "for row in data:\n",
    "    message=row.get(\"Message\")\n",
    "    if message:\n",
    "        send_telegram_message(message)\n",
    "        time.sleep(1)"
   ]
  },
